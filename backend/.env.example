# ------------------------------------------------------------------
# InferSight backend configuration
# Copy to .env and adjust for your environment.
# ------------------------------------------------------------------

APP_NAME=InferSight API
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api/v1

# Comma-separated list of allowed CORS origins (frontend dev servers).
# In production add your deployed frontend origin, e.g.:
# CORS_ORIGINS=https://infersight.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Security ------------------------------------------------------
# CHANGE THIS in production. Use: python -c "import secrets;print(secrets.token_urlsafe(64))"
SECRET_KEY=dev-secret-key-0123456789abcdefghijklmnopqrstuvwxyz-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Storage -------------------------------------------------------
# SQLite (zero-config, local dev):
DATABASE_URL=sqlite:///./inferSight.db
# PostgreSQL (production) — psycopg v3 is bundled in requirements.txt.
# A bare postgresql:// URL is normalized to postgresql+psycopg:// at startup.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/infersight
DATABASE_ECHO=false

# Redis is optional — the app degrades to an in-process cache when
# the server is unreachable or REDIS_ENABLED=false.
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true

# --- Alert routing ------------------------------------------------
# Broker used by Celery (alert delivery + five-minute escalation beat).
# Leave blank to fall back to REDIS_URL.
CELERY_BROKER_URL=
# Incoming webhook URL for the Slack delivery channel (blank disables it).
SLACK_WEBHOOK_URL=

# --- Observability -------------------------------------------------
LOG_LEVEL=INFO

# --- LLM (optional) ------------------------------------------------
# Leave blank to use the deterministic rule-based insight engine.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# --- Bootstrap admin (created on first startup in dev/test) --------
ADMIN_EMAIL=admin@infersight.dev
ADMIN_PASSWORD=admin12345
ADMIN_NAME=InferSight Admin
